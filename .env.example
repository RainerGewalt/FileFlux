# TrailTransfer configuration. Copy to .env or export these; TRAILTRANSFER_*
# env vars override any YAML config file. Secrets for transfer backends live in
# rclone.conf, never here.

TRAILTRANSFER_WORKER_ID=worker-01
TRAILTRANSFER_TOPIC_PREFIX=trailtransfer

TRAILTRANSFER_MQTT_HOST=mqtt
TRAILTRANSFER_MQTT_PORT=1883
TRAILTRANSFER_MQTT_USERNAME=
TRAILTRANSFER_MQTT_PASSWORD=

# The policy is the security boundary — required.
TRAILTRANSFER_POLICY_FILE=/config/worker-policy.yaml
# Operator-provided, read-only. TrailTransfer reads it, never writes or logs it.
TRAILTRANSFER_RCLONE_CONFIG=/config/rclone.conf
TRAILTRANSFER_RCLONE_BINARY=rclone

TRAILTRANSFER_MAX_PARALLEL_JOBS=2
TRAILTRANSFER_HEALTH_INTERVAL_SECONDS=30
TRAILTRANSFER_LOG_LEVEL=info

# Reserved: broadcast commands (trailtransfer/all/commands) are NOT implemented
# in v0.1. The policy field allow_broadcast_commands is the authoritative switch.
TRAILTRANSFER_ALLOW_BROADCAST_COMMANDS=false

# Optional: path to a YAML config file (env still overrides it).
# TRAILTRANSFER_CONFIG=/config/config.yaml

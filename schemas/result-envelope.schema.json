{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RainerGewalt/trailtransfer/schemas/result-envelope.schema.json",
  "title": "TrailTransfer sealed result envelope",
  "description": "The record published to trailtransfer/{worker_id}/jobs/{job_id}/result and appended to the evidence journal. Tamper-evident via seq/prev_hash/chain_hash.",
  "type": "object",
  "required": ["schema_version", "worker_id", "seq", "prev_hash", "event_type", "recorded_at", "time_source", "payload", "content_hash", "chain_hash"],
  "properties": {
    "schema_version": { "type": "string" },
    "worker_id": { "type": "string" },
    "seq": { "type": "integer", "minimum": 1, "description": "Monotonic per worker; a gap means a missing record." },
    "prev_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "chain_hash of the previous record; all-zero for the genesis record." },
    "event_type": { "type": "string", "const": "result" },
    "recorded_at": { "type": "string", "format": "date-time", "description": "ISO 8601 UTC at seal time." },
    "time_source": { "type": "string", "description": "e.g. 'system'." },
    "issuer": {
      "type": ["object", "null"],
      "properties": {
        "auth": { "type": "string", "enum": ["self-declared", "none"] },
        "identity": { "type": "string" }
      },
      "required": ["auth"]
    },
    "payload": {
      "type": "object",
      "description": "The result event.",
      "required": ["event_type", "job_id", "worker_id", "status", "policy_version"],
      "properties": {
        "event_type": { "const": "result" },
        "job_id": { "type": "string" },
        "worker_id": { "type": "string" },
        "action": { "type": "string" },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "status": { "type": "string", "enum": ["completed", "failed", "cancelled", "rejected"] },
        "reason": { "type": "string", "description": "Machine reason for rejected/failed, e.g. policy_violation." },
        "detail": { "type": "string" },
        "justification": { "type": "string", "description": "Human 'why', from command.reason." },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "integer" },
        "files_total": { "type": "integer" },
        "files_transferred": { "type": "integer" },
        "bytes_transferred": { "type": "integer" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "rclone_exit_code": { "type": "integer" },
        "policy_version": { "type": "string" },
        "policy_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "worker_version": { "type": "string" },
        "command_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "SHA-256 of JCS(payload)." },
    "chain_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "SHA-256 of JCS(envelope core)." },
    "signature": {
      "type": ["object", "null"],
      "properties": {
        "alg": { "type": "string" },
        "key_id": { "type": "string" },
        "sig": { "type": "string" }
      }
    }
  }
}
